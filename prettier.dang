type Prettier {
  """
  The source directory for the project.
  """
  pub source: Directory!

  """
  The base image to use.
  """
  pub baseImageAddress: String!

  """
  The package manager to use.
  """
  pub packageManager: String!

  new(
    ws: Workspace!,
    baseImageAddress: String! = "oven/bun:1.2.4-alpine",
    packageManager: String! = "bun",
  ) {
    self.source = ws.directory("/")
    self.baseImageAddress = baseImageAddress
    self.packageManager = packageManager
    self
  }

  pub base: Container! {
    container.from(baseImageAddress).
    withMountedCache("/root/.packages", cacheVolume("prettier-packages")).
    withEnvVariable("npm_config_cache", "/root/.packages").
    withEnvVariable("YARN_CACHE_FOLDER", "/root/.packages").
    withEnvVariable("PNPM_HOME", "/root/.packages").
    withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.packages").
    withDirectory("/src", source).
    withWorkdir("/src").
    withEnvVariable("CI", "true").
    withExec([packageManager, "install"])
  }

  pub exec(args: [String!]!): Container! {
    let x = if (packageManager == "npm" or packageManager == "bun") {
      "x"
    } else if (packageManager == "pnpm" or packageManager == "yarn") {
      "dlx"
    } else {
      raise `invalid packageManager ${packageManager}`
    }

    base.withExec([packageManager, x] + args)
  }

  """
  Check that if the files are formatted.
  """
  pub check: Void @check {
    exec(["prettier", "--check", "."]).sync

    null
  }

  """
  Rewrite all processed files in place.
  """
  pub write: Changeset {
    let fixed = exec(["prettier", "--write", "."]).
    directory(".").
    withoutDirectory("node_modules")

    fixed.
    changes(source.withoutDirectory("node_modules"))
  }
}
