"""
Check and fix formatting with Prettier.

https://prettier.io
"""
type Prettier {
  """
  The base image to use.
  """
  baseImageAddress: String!

  """
  Package manager that installs dependencies. Empty detects it per project.
  """
  packageManager: String!

  """
  Extra arguments for the install command.
  """
  installFlags: [String!]!

  """
  Environment variables for Prettier, as KEY=VALUE.
  """
  environment: [String!]!

  new(
    """
    Base image for Prettier containers, e.g. "node:22".
    """
    baseImageAddress: String! = "node:25-alpine",
    """
    Package manager that installs dependencies: npm, yarn, pnpm or bun.
    Empty detects it from package.json's packageManager field, else the
    lockfile, else npm.
    """
    packageManager: String! = "",
    """
    Extra arguments for the install command, e.g. ["--ignore-scripts"].
    """
    installFlags: [String!]! = [],
    """
    Environment variables for Prettier, as KEY=VALUE.
    """
    environment: [String!]! = [],
  ) {
    self.baseImageAddress = baseImageAddress
    self.packageManager = packageManager
    self.installFlags = installFlags
    self.environment = environment
    self
  }

  """
  Prettier projects at or below the working directory, keyed by config root.
  """
  projects(ws: Workspace!): PrettierProjects! {
    PrettierProjects(paths: sorted(configRoots(ws, ".").uniq), tool: self)
  }

  """
  The Prettier project containing a workspace path.
  """
  project(ws: Workspace!, path: String!): PrettierProject! {
    let start = resolvePath(ws, path)
    let found = configRoots(ws, path).filter { dir => contains(dir, start) }
    if (found.length == 0) {
      raise "no Prettier config found containing path: " + path
    } else {
      # The nearest one is the deepest.
      prettierProject(
        found.reduce(".") { best, dir =>
          if (depth(dir) > depth(best)) { dir } else { best }
        },
      )
    }
  }

  let depth(dir: String!): Int! {
    if (dir == ".") { 0 } else { dir.split("/").length }
  }

  let prettierProject(path: String!): PrettierProject! {
    PrettierProject(path: path, tool: self)
  }

  """
  File names that mark a Prettier project root.
  """
  let configFiles: [String!]! = [
    ".prettierrc",
    ".prettierrc.json",
    ".prettierrc.json5",
    ".prettierrc.yaml",
    ".prettierrc.yml",
    ".prettierrc.toml",
    ".prettierrc.js",
    ".prettierrc.mjs",
    ".prettierrc.cjs",
    ".prettierrc.ts",
    ".prettierrc.mts",
    ".prettierrc.cts",
    "prettier.config.js",
    "prettier.config.mjs",
    "prettier.config.cjs",
    "prettier.config.ts",
    "prettier.config.mts",
    "prettier.config.cts",
  ]

  """
  Every directory holding a Prettier config at or below start, plus the
  nearest enclosing one when start holds none, as workspace-root-relative
  paths. start is read like any path argument: relative to the working
  directory, or to the workspace root when absolute. node_modules is skipped.
  """
  let configRoots(ws: Workspace!, start: String!): [String!]! {
    ws
      .findRoots(start: start, markers: configFiles, exclude: ["**/node_modules/**"])
      .map { dir => workspaceRootPath(ws, dir) }
  }

  """
  Resolve a path relative to the working directory, as findRoots returns
  them, into a workspace-root-relative one.
  """
  let workspaceRootPath(ws: Workspace!, cwdRelPath: String!): String! {
    let segments = cwdRelPath.split("/").filter { s => s != "" and s != "." }
    let up = segments.filter { s => s == ".." }.length
    let down = segments.filter { s => s != ".." }
    let resolved = ws.cwd.split("/").filter { s => s != "" }.dropLast(up) + down
    if (resolved.length == 0) { "." } else { resolved.join("/") }
  }

  """
  Resolve a path argument into a workspace-root-relative path.
  """
  let resolvePath(ws: Workspace!, path: String!): String! {
    if (path.hasPrefix("/")) {
      normalize(path)
    } else {
      workspaceRootPath(ws, path)
    }
  }

  """
  Strip leading and trailing slashes; the workspace root is ".".
  """
  let normalize(path: String!): String! {
    let p = path.trimPrefix("/").trimSuffix("/")
    if (p == "") { "." } else { p }
  }

  """
  Whether path is dir or below it.
  """
  let contains(dir: String!, path: String!): Boolean! {
    dir == "." or path == dir or path.hasPrefix(dir + "/")
  }

  """
  path relative to dir, which contains it.
  """
  let relativeTo(dir: String!, path: String!): String! {
    if (path == dir) {
      "."
    } else if (dir == ".") {
      path
    } else {
      path.trimPrefix(dir + "/")
    }
  }

  """
  Directory of a workspace path returned by findUp, or null.
  """
  let dirOf(found: String): String {
    if (found == null) {
      null
    } else {
      normalize((found ?? "").split("/").dropLast(1).join("/"))
    }
  }

  """
  The deepest, so nearest, of the given directories on one path, or null.
  """
  let nearest(dirs: [String]!): String {
    let none: String = null
    dirs.reduce(none) { best, dir =>
      if (dir == null) {
        best
      } else if (best == null) {
        dir
      } else if (depth(dir ?? ".") > depth(best ?? ".")) {
        dir
      } else {
        best
      }
    }
  }

  """
  Workspace-root path of name inside dir.
  """
  let join(dir: String!, name: String!): String! {
    if (dir == ".") { name } else { dir + "/" + name }
  }

  """
  Node container with every package manager's cache on a volume, corepack
  enabled for pnpm and yarn, and browser downloads and git hooks switched off:
  Prettier needs none of them.
  """
  let nodeBase(pm: String!): Container! {
    let base = container
      .from(baseImageAddress)
      .withMountedCache("/root/.npm", cacheVolume("npm-cache"))
      .withEnvVariable("npm_config_cache", "/root/.npm")
      # yarn 1 corrupts a cache shared by concurrent installs.
      .withMountedCache("/root/.yarn-cache", cacheVolume("yarn-cache"), sharing: CacheSharingMode.LOCKED)
      .withEnvVariable("YARN_CACHE_FOLDER", "/root/.yarn-cache")
      .withMountedCache("/root/.bun-cache", cacheVolume("bun-cache"))
      .withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.bun-cache")
      .withMountedCache("/root/.corepack", cacheVolume("corepack"))
      .withEnvVariable("COREPACK_HOME", "/root/.corepack")
      .withEnvVariable("COREPACK_ENABLE_DOWNLOAD_PROMPT", "0")
      .withEnvVariable("CI", "true")
      .withEnvVariable("PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD", "1")
      .withEnvVariable("PUPPETEER_SKIP_DOWNLOAD", "1")
      .withEnvVariable("CYPRESS_INSTALL_BINARY", "0")
      .withEnvVariable("HUSKY", "0")
      .withEnvVariable("SKIP_INSTALL_SIMPLE_GIT_HOOKS", "1")
    if (pm == "pnpm" or pm == "yarn") {
      # Images from node 25 on no longer ship corepack, and --force replaces
      # the yarn they still ship.
      let ctr = if (pm == "pnpm") {
        base
          .withMountedCache("/root/.pnpm-store", cacheVolume("pnpm-store"))
      } else {
        base
      }
      ctr.withExec([
        "sh",
        "-c",
        "command -v corepack >/dev/null 2>&1 || npm install -g --force corepack; corepack enable",
      ])
    } else if (pm == "bun") {
      base.withExec(["sh", "-c", "command -v bun >/dev/null 2>&1 || npm install -g bun"])
    } else {
      base
    }
  }

  """
  Keys feed cache keys and batch arguments, so give them a stable order.
  """
  let sorted(items: [String!]!): [String!]! {
    let empty: [String!]! = []
    items.reduce(empty) { acc, item =>
      acc.takeWhile { x => x <= item } + [item] + acc.dropWhile { x => x <= item }
    }
  }
}

"""
Prettier projects in a workspace, keyed by the directory holding their config.
"""
type PrettierProjects @collection {
  """
  Project root paths.
  """
  paths: [String!]! @keys

  let tool: Prettier!

  """
  A Prettier project, keyed by its root.
  """
  project(path: String!): PrettierProject! @get {
    tool.prettierProject(path)
  }

  """
  Check formatting of the selected projects.
  """
  formatCheck(ws: Workspace!): Void @check {
    # A selection over a list evaluates its elements concurrently, so every
    # project is checked in parallel and every failure is reported.
    let failures = paths.map { p => project(p) }.{{path, failure: checkFailure(ws)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "Prettier failed in " + toString(failures.length) + " project(s):\n"
        + failures.map { result => "- " + result.path + ": " + (result.failure ?? "") }.join("\n")
    }
    null
  }

  """
  Format the selected projects.
  """
  format(ws: Workspace!): Changeset! {
    let projects = paths.map { p => project(p) }
    let failures = projects.{{path, failure: formatFailure(ws)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "Prettier failed in " + toString(failures.length) + " project(s):\n"
        + failures.map { result => "- " + result.path + ": " + (result.failure ?? "") }.join("\n")
    }

    # Each project contributes only its own files (nested projects are cut
    # out), so the layers are disjoint and one diff covers the selection.
    let before = projects.reduce(directory) { acc, p =>
      acc.withDirectory(".", p.placed(ws, p.runner(ws)))
    }
    let after = projects.reduce(directory) { acc, p =>
      acc.withDirectory(".", p.placed(ws, p.formatExec(ws)))
    }
    after.changes(before)
  }
}

"""
A Prettier project: a directory holding a Prettier config, and everything
below it except nested projects.
"""
type PrettierProject {
  """
  Project root, relative to the workspace.
  """
  path: String!

  let tool: Prettier!

  """
  Check formatting of this project.
  """
  formatCheck(ws: Workspace!): Void @check {
    let failure = checkFailure(ws)
    if (failure != null) {
      raise failure ?? ""
    }
    null
  }

  """
  Format this project.
  """
  format(ws: Workspace!): Changeset! {
    let failure = formatFailure(ws)
    if (failure != null) {
      raise failure ?? ""
    }
    # Diff against the container before Prettier ran rather than the
    # workspace, so a lockfile written by the dependency install stays out.
    placed(ws, formatExec(ws)).changes(placed(ws, runner(ws)))
  }

  """
  Why checking this project failed, naming the step, or null when it is
  formatted. It never raises, so a batch reports every project.
  """
  let checkFailure(ws: Workspace!): String {
    {
      let install = installFailure(ws)
      if (install != null) { install } else { toolFailure(checkExec(ws), "prettier --check") }
    } rescue {
      err: Error => err.message
    }
  }

  """
  Why formatting this project failed, naming the step, or null.
  """
  let formatFailure(ws: Workspace!): String {
    {
      let install = installFailure(ws)
      if (install != null) { install } else { toolFailure(formatExec(ws), "prettier --write") }
    } rescue {
      err: Error => err.message
    }
  }

  let checkExec(ws: Workspace!): Container! {
    runner(ws).withExec(prettier(["--check", "."] + excludes(ws)), expect: ReturnType.ANY)
  }

  let formatExec(ws: Workspace!): Container! {
    runner(ws).withExec(prettier(["--write", "."] + excludes(ws)), expect: ReturnType.ANY)
  }

  let toolFailure(ran: Container!, step: String!): String {
    let code = ran.exitCode
    if (code == 0) {
      null
    } else if (code == 127) {
      ran.stderr.trim(" \n")
    } else {
      step + " failed (exit " + toString(code) + "):\n" + ran.stderr.trim(" \n")
    }
  }

  """
  Where runner puts the wrapper. Its name labels Prettier's output, and it
  must not be "prettier": npx runs a prettier it finds on PATH, so a wrapper
  by that name would call itself forever.
  """
  let wrapperPath: String! = "/usr/local/bin/dagger-prettier"

  let prettier(args: [String!]!): [String!]! {
    # Called by name, which labels each line of output in the TUI.
    ["dagger-prettier"] + args
  }

  """
  The prettier command in runner. It runs the project's own Prettier (the
  nearest node_modules/.bin/prettier between the working directory and the
  install root, or yarn's under Plug'n'Play) and says how to fix it when
  there is none; without an install root, npx fetches Prettier. Every output
  line is prefixed with the project, since a batch runs several at once.
  """
  let wrapper(root: String): String! {
    let locate = if (root == null) {
      "set -- npx --yes prettier \"$@\"\n"
    } else {
      "found=\n"
        + "d=\"$PWD\"\n"
        + "while :; do\n"
        + "  if [ -x \"$d/node_modules/.bin/prettier\" ]; then found=\"$d/node_modules/.bin/prettier\"; break; fi\n"
        + "  if [ \"$d\" = /src ] || [ \"$d\" = / ]; then break; fi\n"
        + "  d=$(dirname \"$d\")\n"
        + "done\n"
        + "if [ -n \"$found\" ]; then\n"
        + "  set -- \"$found\" \"$@\"\n"
        + "elif [ -f /src/.pnp.cjs ]; then\n"
        + "  set -- yarn prettier \"$@\"\n"
        + "else\n"
        + "  echo \"prettier is not installed: add it to the devDependencies of "
        + tool.join(root ?? ".", "package.json")
        + " (or of a package.json between it and the project)\" >&2\n"
        + "  exit 127\n"
        + "fi\n"
    }
    "#!/bin/sh\n"
      + locate
      + "prefix() { awk -v p=\"[$PRETTIER_PROJECT] \" '{ print p $0; fflush() }'; }\n"
      + "{ { \"$@\"; echo $? > /tmp/prettier-exit; } 2>&1 1>&3 | prefix >&2; } 3>&1 | prefix\n"
      + "exit \"$(cat /tmp/prettier-exit)\"\n"
  }

  """
  Where dependencies are installed: the nearest workspace root at or above
  this project (pnpm-workspace.yaml, or a package.json with "workspaces"),
  else the nearest lockfile's directory, else the nearest package.json's.
  Null when there is no package.json at or above the project.
  """
  let installRoot(ws: Workspace!): String {
    let from = "/" + path
    if (ws.findUp("package.json", from) == null) {
      null
    } else {
      let workspaceRoot = tool.nearest([
        tool.dirOf(ws.findUp("pnpm-workspace.yaml", from)),
        workspacesRoot(ws, from),
      ])
      let lockRoot = tool.nearest(
        lockfiles.map { name => tool.dirOf(ws.findUp(name, from)) },
      )
      workspaceRoot ?? lockRoot ?? tool.dirOf(ws.findUp("package.json", from))
    }
  }

  let lockfiles: [String!]! = [
    "pnpm-lock.yaml",
    "yarn.lock",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "bun.lock",
    "bun.lockb",
  ]

  """
  The nearest directory at or above from whose package.json declares
  "workspaces", or null.
  """
  let workspacesRoot(ws: Workspace!, from: String!): String {
    let found = ws.findUp("package.json", from)
    if (found == null) {
      null
    } else {
      let dir = tool.dirOf(found) ?? "."
      if (ws.file(found ?? "").contents.contains("\"workspaces\"")) {
        dir
      } else if (dir == ".") {
        null
      } else {
        workspacesRoot(ws, "/" + (tool.dirOf("/" + dir) ?? "."))
      }
    }
  }

  """
  The configured package manager, else the one root's package.json names in
  "packageManager", else the one its lockfile belongs to, else npm.
  """
  let packageManager(ws: Workspace!, root: String!): String! {
    if (tool.packageManager != "") {
      tool.packageManager
    } else {
      let text = { ws.file("/" + tool.join(root, "package.json")).contents } rescue {
        err: Error => ""
      }
      let declared = if (text.contains("\"packageManager\"")) {
        text.replaceMatches(`(?s)^.*"packageManager"\s*:\s*"([a-zA-Z]+)@.*$`, with: "$1")
      } else {
        ""
      }
      if (["npm", "pnpm", "yarn", "bun"].contains(declared)) {
        declared
      } else if (has(ws, root, "pnpm-lock.yaml") or has(ws, root, "pnpm-workspace.yaml")) {
        "pnpm"
      } else if (has(ws, root, "yarn.lock")) {
        "yarn"
      } else if (has(ws, root, "bun.lock") or has(ws, root, "bun.lockb")) {
        "bun"
      } else {
        "npm"
      }
    }
  }

  let has(ws: Workspace!, dir: String!, name: String!): Boolean! {
    ws.findUp(name, "/" + dir) == "/" + tool.join(dir, name)
  }

  """
  Everything the install reads, and nothing else, so editing source files
  does not re-run it. That includes the directories package managers copy
  in: file:, link: and portal: dependencies. When the package.json files
  can't be read, or pnpm injects a workspace package, the install gets the
  full source instead.
  """
  let installInputs(ws: Workspace!, root: String!): Directory! {
    let local = localDependencies(ws, root)
    if (local == null) {
      ws.directory("/" + root, exclude: ["**/node_modules"])
    } else {
      let extra = (local ?? []).reduce(emptyList) { acc, dir => acc + [dir, dir + "/**"] }
      ws.directory("/" + root, include: installFiles + extra, exclude: ["**/node_modules"])
    }
  }

  let emptyList: [String!]! = []

  let installFiles: [String!]! = [
    "**/package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".pnpmfile.cjs",
    "yarn.lock",
    ".yarnrc",
    ".yarnrc.yml",
    ".yarn/releases/**",
    ".yarn/plugins/**",
    ".yarn/patches/**",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "bun.lock",
    "bun.lockb",
    "bunfig.toml",
    "**/.npmrc",
    "patches/**",
  ]

  """
  Paths, relative to root, of the file:, link: and portal: dependencies that
  the package.json files under root name, or null to install from the full
  source.
  """
  let localDependencies(ws: Workspace!, root: String!): [String!] {
    {
      let dirs = ws
        .findRoots(start: "/" + root, markers: ["package.json"], exclude: ["**/node_modules/**"])
        .map { dir => tool.workspaceRootPath(ws, dir) }
        .filter { dir => tool.contains(root, dir) }
      let found = dirs.reduce(emptyList) { acc, dir =>
        let text = ws.file("/" + tool.join(dir, "package.json")).contents
        if (text.contains("\"injected\"")) {
          raise "injected workspace packages need the full source"
        }
        acc + text
          .matchAll(`"(?:file|link|portal):[^"]+"`)
          .map { m => m.string.replaceMatches(`^"(?:file|link|portal):|"$`, with: "") }
          .filter { spec => spec.hasPrefix("/") == false }
          .map { spec => resolve(dir, spec) }
          .filter { target => target != ".." and tool.contains(root, target) }
          .map { target => tool.relativeTo(root, target) }
      }
      found.uniq
    } rescue {
      err: Error => null
    }
  }

  """
  A path relative to dir, as a workspace-root path, or ".." when it leaves the
  workspace.
  """
  let resolve(dir: String!, relative: String!): String! {
    let start = if (dir == ".") { emptyList } else { dir.split("/") }
    let segments = (start + relative.split("/")).reduce(emptyList) { acc, s =>
      if (s == "" or s == "." or acc == [".."]) {
        acc
      } else if (s == "..") {
        if (acc.length == 0) { [".."] } else { acc.dropLast(1) }
      } else {
        acc + [s]
      }
    }
    if (segments.length == 0) { "." } else { segments.join("/") }
  }

  let installCommand(ws: Workspace!, root: String!): [String!]! {
    let pm = packageManager(ws, root)
    # pnpm 12 ignores npm_config_store_dir, so name the cached store here.
    let store = if (pm == "pnpm") { ["--store-dir", "/root/.pnpm-store"] } else { [] }
    [pm, "install"] + store + tool.installFlags
  }

  """
  The install root with its dependencies installed. The install may have
  failed: read exitCode.
  """
  let installed(ws: Workspace!, root: String!): Container! {
    tool
      .nodeBase(packageManager(ws, root))
      .withDirectory("/src", installInputs(ws, root))
      .withWorkdir("/src")
      .withExec(installCommand(ws, root), expect: ReturnType.ANY)
  }

  """
  Why installing dependencies failed, with the end of its output, or null.
  """
  let installFailure(ws: Workspace!): String {
    let root = installRoot(ws)
    if (root == null) {
      null
    } else {
      let ran = installed(ws, root ?? ".")
      let code = ran.exitCode
      if (code == 0) {
        null
      } else {
        let output = (ran.stdout.trim(" \n") + "\n" + ran.stderr.trim(" \n")).trim(" \n")
        "install failed (" + installCommand(ws, root ?? ".").join(" ") + ", exit " + toString(code)
          + "):\n" + output.split("\n").takeLast(15).join("\n")
      }
    }
  }

  """
  Nested projects, relative to this one. Each is checked on its own, with its
  own config and ignore file, so this project leaves them alone.
  """
  let nested(ws: Workspace!): [String!]! {
    tool
      .configRoots(ws, "/" + path)
      .filter { dir => dir != path and tool.contains(path, dir) }
      .map { dir => tool.relativeTo(path, dir) }
  }

  """
  What the install writes into the source tree that isn't node_modules:
  yarn Plug'n'Play's loaders and its .yarn directory. Prettier leaves them
  alone and format never returns them.
  """
  let installArtifacts: [String!]! = ["**/.pnp.cjs", "**/.pnp.loader.mjs", "**/.yarn"]

  let excludes(ws: Workspace!): [String!]! {
    excludeNested(ws) + ["!**/.pnp.cjs", "!**/.pnp.loader.mjs", "!**/.yarn/**"]
  }

  let excludeNested(ws: Workspace!): [String!]! {
    nested(ws).map { dir => "!" + dir + "/**" }
  }

  """
  Container that runs Prettier, with this project as the working directory.
  With a package.json at or above the project, the install root's
  dependencies are installed and the source laid over them; otherwise npx
  fetches Prettier on demand.
  """
  let runner(ws: Workspace!): Container! {
    let root = installRoot(ws)
    let mount = root ?? path
    let source = ws.directory("/" + mount, exclude: ["**/node_modules"], gitignore: true)
    let ctr = if (root == null) {
      tool.nodeBase("npm").withDirectory("/src", source)
    } else {
      installed(ws, root ?? ".").withDirectory("/src", source)
    }
    let dir = tool.relativeTo(mount, path)
    let configured = tool.environment.reduce(ctr) { acc, pair =>
      let key = pair.replaceMatches(`(?s)=.*$`, with: "")
      acc.withEnvVariable(key, pair.trimPrefix(key + "="))
    }
    # Plain output, so reports read cleanly in error messages.
    configured
      # 493 is 0755.
      .withNewFile(wrapperPath, wrapper(root), permissions: 493)
      .withEnvVariable("PRETTIER_PROJECT", path)
      .withEnvVariable("NO_COLOR", "1")
      .withWorkdir(if (dir == ".") { "/src" } else { "/src/" + dir })
  }

  """
  The part of this project's tree in ctr that the caller can change, rooted at
  the caller's working directory. The CLI applies a changeset from where the
  caller stands, so a project below it is placed at its relative path, and an
  enclosing project contributes only the caller's subtree.
  """
  let placed(ws: Workspace!, ctr: Container!): Directory! {
    let cwd = tool.normalize(ws.cwd)
    let own = nested(ws).reduce(ctr.directory(".")) { dir, sub => dir.withoutDirectory(sub) }
    let files = directory.withDirectory(".", own, exclude: ["**/node_modules"] + installArtifacts)
    if (tool.contains(cwd, path)) {
      directory.withDirectory(tool.relativeTo(cwd, path), files)
    } else {
      files.directory(tool.relativeTo(path, cwd))
    }
  }
}
