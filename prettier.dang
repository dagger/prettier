type Prettier {
  """
  The source directory for the project.
  """
  pub source: Directory!

  """
  Path of the client's working directory, relative to the workspace root.
  """
  pub path: String!

  """
  The base image to use.
  """
  pub baseImageAddress: String!

  """
  The package manager to use.
  """
  pub packageManager: String!

  new(
    ws: Workspace!,
    baseImageAddress: String! = "node:25-alpine",
    packageManager: String! = "npm",
  ) {
    self.source = ws.directory("/")
    self.path = ws.path
    self.baseImageAddress = baseImageAddress
    self.packageManager = packageManager
    self
  }

  """
  Check that if the files are formatted.
  """
  pub check: Void @check {
    nodejs(source, baseImageAddress, packageManager).base.
    withWorkdir("/src/" + path).
    withExec(["npx", "prettier", "--check", "."]).
    sync

    null
  }

  """
  Rewrite all processed files in place.
  """
  pub write: Changeset {
    let fixed = nodejs(source, baseImageAddress, packageManager).base.
    withWorkdir("/src/" + path).
    withExec(["npx", "prettier", "--write", "."]).
    directory("/src").
    withoutDirectory("node_modules")

    fixed.
    changes(source.withoutDirectory("node_modules"))
  }
}
