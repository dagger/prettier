"""
End-to-end checks for the prettier toolchain.
"""
type E2e {
  """
  The git repository to format-check as an end-to-end smoke test.
  """
  pub repo: String! = "https://github.com/dagger/hello-dagger"

  """
  Run the prettier toolchain against a real-world repository.

  The hello-dagger repo isn't prettier-formatted, so this first applies
  `write` to format the workspace, then runs `check` against the
  formatted result to exercise both ends of the toolchain.
  """
  pub checkHelloDagger: Void @check {
    let ws = git(repo).head.tree.asWorkspace

    let formatted = prettier(ws).write.after.asWorkspace

    prettier(formatted).check
  }
}
